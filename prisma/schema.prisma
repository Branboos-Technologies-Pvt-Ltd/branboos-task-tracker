// Branboos Task Tracker — data model
// Docs: https://pris.ly/d/prisma-schema
//
// NOTE: We deliberately do NOT declare Supabase's `auth` schema here.
// The profiles.id → auth.users.id foreign key is created via
// prisma/sql/001_auth_bridge.sql and lives outside Prisma's world.
// Schema changes are applied by hand-written SQL files in prisma/sql
// rather than `prisma migrate dev`, because Prisma would otherwise
// see the entire auth schema as drift and want to reset the DB.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Mirror of Supabase auth.users. The `id` matches auth.users.id (UUID).
// A row here is created via a trigger when a user signs up (see auth-bridge SQL).
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   WorkspaceMember[]
  createdBoards Board[]           @relation("BoardCreatedBy")
  createdLists  List[]            @relation("ListCreatedBy")
  assignedCards Card[]            @relation("CardAssignee")
  authoredCards Card[]            @relation("CardCreatedBy")
  comments      Comment[]
  activities    Activity[]        @relation("ActivityActor")
  targetedInActivities Activity[] @relation("ActivityTargetUser")
  receivedNotifications Notification[] @relation("NotificationRecipient")
  sentNotifications     Notification[] @relation("NotificationActor")

  @@map("profiles")
}

enum WorkspaceRole {
  owner
  admin
  member

  @@map("workspace_role")
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  prefix    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members    WorkspaceMember[]
  boards     Board[]
  cards      Card[]
  labels     Label[]
  activities Activity[]
  sequence   WorkspaceCardSequence?

  @@map("workspaces")
}

model WorkspaceCardSequence {
  workspaceId String @id @map("workspace_id") @db.Uuid
  lastNumber  Int    @default(0) @map("last_number")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_card_sequences")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  profileId   String        @map("profile_id") @db.Uuid
  role        WorkspaceRole @default(member)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([workspaceId, profileId])
  @@map("workspace_members")
}

model Board {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  description String?
  color       String?
  createdById String    @map("created_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     Profile        @relation("BoardCreatedBy", fields: [createdById], references: [id])
  lists         List[]
  activities    Activity[]
  notifications Notification[]

  @@index([workspaceId])
  @@map("boards")
}

model List {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId     String   @map("board_id") @db.Uuid
  name        String
  position    Float
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy Profile? @relation("ListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cards     Card[]

  @@index([boardId, position])
  @@index([createdById])
  @@map("lists")
}

enum CardPriority {
  low
  medium
  high
  urgent

  @@map("card_priority")
}

model Card {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  number      Int
  listId      String        @map("list_id") @db.Uuid
  title       String
  description String?
  component   String?
  position    Float
  priority    CardPriority?
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")
  assigneeId  String?       @map("assignee_id") @db.Uuid
  createdById String        @map("created_by") @db.Uuid
  archivedAt  DateTime?     @map("archived_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list           List                 @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee       Profile?             @relation("CardAssignee", fields: [assigneeId], references: [id])
  createdBy      Profile              @relation("CardCreatedBy", fields: [createdById], references: [id])
  comments       Comment[]
  labels         CardLabel[]
  checklistItems CardChecklistItem[]
  activities     Activity[]
  notifications  Notification[]

  @@unique([workspaceId, number])
  @@index([listId, position])
  @@index([assigneeId])
  @@map("cards")
}

model Activity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  type         String
  boardId      String?  @map("board_id") @db.Uuid
  cardId       String?  @map("card_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor      Profile?  @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  board      Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card       Card?     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  targetUser Profile?  @relation("ActivityTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([cardId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("activities")
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  type        String
  boardId     String?   @map("board_id") @db.Uuid
  cardId      String?   @map("card_id") @db.Uuid
  message     String
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  recipient Profile  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     Profile? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  board     Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card      Card?    @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

model CardChecklistItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId      String    @map("card_id") @db.Uuid
  text        String
  done        Boolean   @default(false)
  position    Float
  createdById String?   @map("created_by") @db.Uuid
  doneById    String?   @map("done_by") @db.Uuid
  doneAt      DateTime? @map("done_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId, position])
  @@map("card_checklist_items")
}

// Workspace-scoped labels. Replace the single `component` string on Card
// (kept for backward compat, backfilled at migration).
model Label {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  color       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     CardLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model CardLabel {
  cardId  String @map("card_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card   Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id])

  @@index([cardId, createdAt])
  @@map("comments")
}
