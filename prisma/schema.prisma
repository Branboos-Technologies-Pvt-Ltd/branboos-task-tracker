// Branboos Task Tracker — data model
// Docs: https://pris.ly/d/prisma-schema
//
// NOTE: We deliberately do NOT declare Supabase's `auth` schema here.
// The profiles.id → auth.users.id foreign key is created via
// prisma/sql/001_auth_bridge.sql and lives outside Prisma's world.
// Schema changes are applied by hand-written SQL files in prisma/sql
// rather than `prisma migrate dev`, because Prisma would otherwise
// see the entire auth schema as drift and want to reset the DB.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Mirror of Supabase auth.users. The `id` matches auth.users.id (UUID).
// A row here is created via a trigger when a user signs up (see auth-bridge SQL).
model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships   WorkspaceMember[]
  createdBoards Board[]           @relation("BoardCreatedBy")
  createdLists  List[]            @relation("ListCreatedBy")
  assignedCards Card[]            @relation("CardAssignee")
  authoredCards Card[]            @relation("CardCreatedBy")
  comments      Comment[]

  @@map("profiles")
}

enum WorkspaceRole {
  owner
  admin
  member

  @@map("workspace_role")
}

model Workspace {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  prefix    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members  WorkspaceMember[]
  boards   Board[]
  cards    Card[]
  labels   Label[]
  sequence WorkspaceCardSequence?

  @@map("workspaces")
}

model WorkspaceCardSequence {
  workspaceId String @id @map("workspace_id") @db.Uuid
  lastNumber  Int    @default(0) @map("last_number")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("workspace_card_sequences")
}

model WorkspaceMember {
  workspaceId String        @map("workspace_id") @db.Uuid
  profileId   String        @map("profile_id") @db.Uuid
  role        WorkspaceRole @default(member)
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([workspaceId, profileId])
  @@map("workspace_members")
}

model Board {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  name        String
  description String?
  color       String?
  createdById String    @map("created_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Profile   @relation("BoardCreatedBy", fields: [createdById], references: [id])
  lists     List[]

  @@index([workspaceId])
  @@map("boards")
}

model List {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  boardId     String   @map("board_id") @db.Uuid
  name        String
  position    Float
  createdById String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy Profile? @relation("ListCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cards     Card[]

  @@index([boardId, position])
  @@index([createdById])
  @@map("lists")
}

enum CardPriority {
  low
  medium
  high
  urgent

  @@map("card_priority")
}

model Card {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  number      Int
  listId      String        @map("list_id") @db.Uuid
  title       String
  description String?
  component   String?
  position    Float
  priority    CardPriority?
  startDate   DateTime?     @map("start_date")
  dueDate     DateTime?     @map("due_date")
  assigneeId  String?       @map("assignee_id") @db.Uuid
  createdById String        @map("created_by") @db.Uuid
  archivedAt  DateTime?     @map("archived_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      List        @relation(fields: [listId], references: [id], onDelete: Cascade)
  assignee  Profile?    @relation("CardAssignee", fields: [assigneeId], references: [id])
  createdBy Profile     @relation("CardCreatedBy", fields: [createdById], references: [id])
  comments  Comment[]
  labels    CardLabel[]

  @@unique([workspaceId, number])
  @@index([listId, position])
  @@index([assigneeId])
  @@map("cards")
}

// Workspace-scoped labels. Replace the single `component` string on Card
// (kept for backward compat, backfilled at migration).
model Label {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  color       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     CardLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("labels")
}

model CardLabel {
  cardId  String @map("card_id") @db.Uuid
  labelId String @map("label_id") @db.Uuid

  card  Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  @@index([labelId])
  @@map("card_labels")
}

model Comment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  card   Card    @relation(fields: [cardId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id])

  @@index([cardId, createdAt])
  @@map("comments")
}
